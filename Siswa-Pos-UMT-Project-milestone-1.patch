diff --git a/.env.example b/.env.example
index 91c999d..2bdc910 100644
--- a/.env.example
+++ b/.env.example
@@ -1,5 +1,9 @@
 # Local development only. Never commit a real production database URL.
 DATABASE_URL="postgresql://siswa_pos:change-me-in-local-env@localhost:5432/siswa_pos?schema=public"
 
-# Change only when the public deployment is ready.
+# Leave localhost for local development; set only at deployment time.
 NEXT_PUBLIC_APP_URL="http://localhost:3000"
+
+# Required only when seeding the fictional demo accounts. Set locally; never commit values.
+DEMO_ADMIN_PASSWORD=""
+DEMO_STAFF_PASSWORD=""
diff --git a/README.md b/README.md
index 1231b6c..1cff329 100644
--- a/README.md
+++ b/README.md
@@ -16,8 +16,9 @@ Siswa Pos is a full-stack student-parcel management prototype. It is designed to
 ## What exists in this first foundation
 
 - Public product landing page
-- Student demo lookup at `/student` using the fictional tracking number `SPX-2026-0001`
-- Staff-dashboard interface mock-up at `/staff`
+- Database-backed student lookup at `/student` using a tracking number and final four fictional matric digits
+- Demo staff/admin sign-in, session handling, protected parcel list, and parcel-registration API at `/staff`
+- Seed script for strictly fictional users and records; local passwords are required at runtime and are never committed
 - Health endpoint at `/api/health`
 - PostgreSQL/Prisma data model for users, students, parcels, QR claims, collections and audit events
 - Docker, CI and Kubernetes deployment foundations
@@ -43,6 +44,7 @@ npm run build
 npm run db:generate
 npm run db:migrate
 npm run db:deploy
+npm run db:seed
 ```
 
 ## Before a public deployment
diff --git a/compose.yaml b/compose.yaml
index 3a028ad..9f576de 100644
--- a/compose.yaml
+++ b/compose.yaml
@@ -6,7 +6,7 @@ services:
       POSTGRES_USER: siswa_pos
       POSTGRES_PASSWORD: change-me-in-local-env
     ports:
-      - "5432:5432"
+      - "127.0.0.1:5432:5432"
     healthcheck:
       test: ["CMD-SHELL", "pg_isready -U siswa_pos -d siswa_pos"]
       interval: 5s
